{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/psyberone/imitation-krab/schemas/v1/claim-list.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["trusted_metadata", "claims"],
  "properties": {
    "trusted_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_key", "kind", "count"],
      "properties": {
        "project_key": {"type": "string"},
        "kind": {"enum": ["issue", "pull_request"]},
        "count": {"type": "integer", "minimum": 0}
      }
    },
    "claims": {"type": "array", "items": {"$ref": "resources.schema.json#/$defs/claim"}}
  }
}
