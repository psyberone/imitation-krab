{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/psyberone/imitation-krab/schemas/v1/resources.schema.json",
  "$defs": {
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "handle"],
      "properties": {
        "user_id": {"type": "string", "pattern": "^usr_[0-9a-f]{32}$"},
        "handle": {"type": "string"}
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "item_status": {
      "enum": [
        "open.pending",
        "open.in_progress",
        "open.under_review",
        "open.needs_changes",
        "open.approved",
        "closed.approved",
        "closed.rejected"
      ]
    },
    "nullable_item_status": {
      "oneOf": [
        {"$ref": "#/$defs/item_status"},
        {"type": "null"}
      ]
    },
    "work_claim_link": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim_id", "kind", "external_id"],
          "properties": {
            "claim_id": {"type": "string", "pattern": "^clm_[0-9a-f]{32}$"},
            "kind": {"enum": ["issue", "pull_request"]},
            "external_id": {"type": "string"}
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trusted_metadata"],
      "properties": {
        "trusted_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claim_id", "project_key", "kind", "external_id", "status",
            "version", "review_round", "assignee", "created_by", "created_at",
            "updated_at"
          ],
          "properties": {
            "claim_id": {"type": "string", "pattern": "^clm_[0-9a-f]{32}$"},
            "project_key": {"type": "string"},
            "kind": {"enum": ["issue", "pull_request"]},
            "external_id": {"type": "string"},
            "status": {"enum": ["available", "claimed", "active", "under_review", "done"]},
            "version": {"type": "integer", "minimum": 1},
            "review_round": {"type": "integer", "minimum": 0},
            "assignee": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/user"}]},
            "created_by": {"$ref": "#/$defs/user"},
            "created_at": {"type": "string", "format": "date-time"},
            "updated_at": {"type": "string", "format": "date-time"}
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trusted_metadata", "untrusted_text", "content_risk_flags"],
      "properties": {
        "trusted_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_seq", "kind", "project_key", "session_id", "item_id", "actor",
            "creator", "recipient", "work_claim", "from_status", "to_status",
            "current_status", "version", "created_at"
          ],
          "properties": {
            "event_seq": {"type": "integer", "minimum": 1},
            "kind": {"enum": ["item.created", "status.changed", "item.reminded"]},
            "project_key": {"type": "string"},
            "session_id": {"type": "string", "pattern": "^ses_[0-9a-f]{32}$"},
            "item_id": {"type": "string", "pattern": "^itm_[0-9a-f]{32}$"},
            "actor": {"$ref": "#/$defs/user"},
            "creator": {"$ref": "#/$defs/user"},
            "recipient": {"$ref": "#/$defs/user"},
            "work_claim": {"$ref": "#/$defs/work_claim_link"},
            "from_status": {"$ref": "#/$defs/nullable_item_status"},
            "to_status": {"$ref": "#/$defs/nullable_item_status"},
            "current_status": {"$ref": "#/$defs/item_status"},
            "version": {"type": "integer", "minimum": 1},
            "created_at": {"type": "string", "format": "date-time"}
          }
        },
        "untrusted_text": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": {
            "title": {"type": "string"},
            "body": {"type": "string"},
            "note": {"type": "string"}
          }
        },
        "content_risk_flags": {"$ref": "#/$defs/risk_flags"}
      }
    },
    "history_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trusted_metadata", "untrusted_text", "content_risk_flags"],
      "properties": {
        "trusted_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_seq", "kind", "actor", "from_status", "to_status", "created_at"
          ],
          "properties": {
            "event_seq": {"type": "integer", "minimum": 1},
            "kind": {"enum": ["item.created", "status.changed", "item.reminded"]},
            "actor": {"$ref": "#/$defs/user"},
            "from_status": {"$ref": "#/$defs/nullable_item_status"},
            "to_status": {"$ref": "#/$defs/nullable_item_status"},
            "created_at": {"type": "string", "format": "date-time"}
          }
        },
        "untrusted_text": {
          "type": "object",
          "additionalProperties": false,
          "required": ["note"],
          "properties": {"note": {"type": ["string", "null"]}}
        },
        "content_risk_flags": {"$ref": "#/$defs/risk_flags"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trusted_metadata", "untrusted_text", "content_risk_flags"],
      "properties": {
        "trusted_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item_id", "project_key", "session_id", "creator", "recipient",
            "work_claim", "status", "version", "created_at", "updated_at"
          ],
          "properties": {
            "item_id": {"type": "string", "pattern": "^itm_[0-9a-f]{32}$"},
            "project_key": {"type": "string"},
            "session_id": {"type": "string", "pattern": "^ses_[0-9a-f]{32}$"},
            "creator": {"$ref": "#/$defs/user"},
            "recipient": {"$ref": "#/$defs/user"},
            "work_claim": {"$ref": "#/$defs/work_claim_link"},
            "status": {"$ref": "#/$defs/item_status"},
            "version": {"type": "integer", "minimum": 1},
            "created_at": {"type": "string", "format": "date-time"},
            "updated_at": {"type": "string", "format": "date-time"},
            "event_seq": {"type": "integer", "minimum": 1}
          }
        },
        "untrusted_text": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "body"],
          "properties": {
            "title": {"type": "string"},
            "body": {"type": "string"}
          }
        },
        "content_risk_flags": {"$ref": "#/$defs/risk_flags"},
        "history": {"type": "array", "items": {"$ref": "#/$defs/history_event"}}
      }
    },
    "review_history_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trusted_metadata"],
      "properties": {
        "trusted_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "actor", "from_status", "to_status", "review_round", "created_at"],
          "properties": {
            "action": {"enum": ["submitted", "changes_requested", "approved"]},
            "actor": {"$ref": "#/$defs/user"},
            "from_status": {"type": ["string", "null"]},
            "to_status": {"type": ["string", "null"]},
            "review_round": {"type": "integer", "minimum": 0},
            "created_at": {"type": "string", "format": "date-time"},
            "notification_item_id": {"type": "string", "pattern": "^itm_[0-9a-f]{32}$"},
            "notification_event_seq": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
